@page "/braga/curriculo"

<PageTitle>Currículo - Arthur Braga</PageTitle>

<div class="braga-portfolio">
    <div class="pagina-interna">
        <div class="container-conteudo">
            <h1 class="titulo-pagina">Meu Currículo</h1>

            <div style="display: grid; gap: 2rem; grid-template-columns: 1fr 2fr;">
                <!-- Sidebar -->
                <aside>
                    <div class="card-content">
                        <h3 style="color: var(--primary); margin-bottom: 1.5rem;">Competências</h3>
                        
                        <div style="margin-bottom: 1.5rem;">
                            <h4 style="font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">Front-end</h4>
                            <ul style="list-style: none; padding: 0;">
                                <li>• HTML5 / CSS3</li>
                                <li>• JavaScript (ES6+)</li>
                                <li>• Blazor / C#</li>
                            </ul>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <h4 style="font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">Outros</h4>
                            <ul style="list-style: none; padding: 0;">
                                <li>• Robótica</li>
                                <li>• Desenvolvimento Mobile</li>
                                <li>• Git / GitHub</li>
                            </ul>
                        </div>

                        <div>
                            <h4 style="font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">Idiomas</h4>
                            <ul style="list-style: none; padding: 0;">
                                <li>• Português (Nativo)</li>
                                <li>• Inglês (Intermediário)</li>
                            </ul>
                        </div>
                    </div>
                </aside>

                <!-- Main Content -->
                <main>
                    <div class="card-content">
                        <h3 style="color: var(--primary); margin-bottom: 1.5rem;">Experiência</h3>
                        
                        <div style="margin-bottom: 2rem; border-left: 2px solid var(--primary); padding-left: 1.5rem;">
                            <h4 style="margin: 0;">Desenvolvedor Full Stack (Estudante)</h4>
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">IFRO | 2024 - Presente</p>
                            <p>Desenvolvimento de aplicações web utilizando C# e Blazor. Criação de interfaces responsivas e integração com APIs.</p>
                        </div>

                        <div style="margin-bottom: 2rem; border-left: 2px solid var(--primary); padding-left: 1.5rem;">
                            <h4 style="margin: 0;">Membro da Equipe de Robótica</h4>
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">IFRO | 2024</p>
                            <p>Programação de microcontroladores e montagem de protótipos para competições acadêmicas.</p>
                        </div>
                    </div>

                    <div class="card-content">
                        <h3 style="color: var(--primary); margin-bottom: 1.5rem;">Formação</h3>
                        
                        <div style="margin-bottom: 1.5rem;">
                            <h4 style="margin: 0;">Técnico em Informática Integrado ao Ensino Médio</h4>
                            <p style="color: var(--text-muted); font-size: 0.9rem;">IFRO - Instituto Federal de Rondônia</p>
                        </div>
                    </div>
                </main>
            </div>

            <div style="text-align: center; margin-top: 2rem;">
                <a href="/braga" style="color: var(--primary); text-decoration: none; font-weight: 700;">← Voltar para Home</a>
            </div>
        </div>
    </div>
</div>
