@page "/uriel-home"

<PageTitle>Portfólio Uriel</PageTitle>

<section class="pagina-inicial">
    <section class="hero-tile">
        <div class="tile-content">
            <h2 class="tagline">Desenvolvedor Backend</h2>
            <h1 class="display-lg">Uriel — construindo soluções em tempo recorde</h1>
            <p class="lead">Experiência com APIs, banco de dados e arquitetura backend. Foco em performance, organização e boas práticas.</p>
            <div class="actions">
                <a href="/curriculo" class="button-primary">Ver currículo</a>
                <a href="/contato" class="button-secondary-pill">Entrar em contato</a>
            </div>
        </div>
    </section>

    <section class="grid-section">
        <div class="utility-grid">
            <div class="store-utility-card">
                <h2 class="body-strong">01. Trajetória</h2>
                <p class="body">Formação técnica no IFRO e projetos de pesquisa com foco em evolução contínua na prática.</p>
                <div class="card-action">
                    <a href="/minha-historia" class="text-link">Ver trajetória</a>
                </div>
            </div>

            <div class="store-utility-card">
                <h2 class="body-strong">02. Experiência</h2>
                <p class="body">Desenvolvedor backend (SISGHA/SISGEA). Stack: NestJS, C#, Go. Infraestrutura: Docker e Kubernetes.</p>
                <div class="card-action">
                    <a href="/curriculo" class="text-link">Ver habilidades</a>
                </div>
            </div>
            
            <div class="store-utility-card">
                <h2 class="body-strong">03. Contato</h2>
                <p class="body">Aberto a novas oportunidades, projetos freelancers e parcerias na área de tecnologia.</p>
                <div class="card-action">
                    <a href="/contato" class="text-link">Vamos conversar</a>
                </div>
            </div>
        </div>
    </section>
</section>