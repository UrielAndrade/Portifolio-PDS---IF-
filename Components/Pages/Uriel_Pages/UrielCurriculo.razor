@page "/curriculo"

<PageTitle>Currículo — Uriel</PageTitle>
<style>
    body { margin: 0; background-color: #050505; }
</style>

<section class="uriel-cyberpunk">
    <div class="hero-section">
        <div class="hero-content">
            <h2 class="tagline">DATA_RECORD // CURRÍCULO</h2>
            <h1 class="display-lg">Skills <span class="highlight">& Tech</span></h1>
            <p class="lead">Estudante Técnico em Informática. Especialista em Backend, APIs REST e Infraestrutura Linux.</p>
        </div>
    </div>

    <div class="grid-section">
        <div class="utility-grid">
            <div class="cyber-card">
                <div class="card-header">
                    <span class="cyber-id">01</span>
                    <h2 class="card-title">Formação</h2>
                </div>
