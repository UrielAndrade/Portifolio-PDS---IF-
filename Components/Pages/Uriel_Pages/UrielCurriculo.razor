@page "/curriculo"

<PageTitle>Currículo — Uriel</PageTitle>

<section class="curriculo">
    <div class="hero-section product-tile-dark">
        <div class="hero-content">
            <h2 class="tagline">Currículo</h2>
            <h1 class="display-lg">Uriel Andrade</h1>
            <p class="lead">Estudante de Técnico em Informática com foco em backend, APIs REST e infraestrutura Linux.</p>
        </div>
    </div>

    <div class="resume-content product-tile-parchment">
        <div class="resume-grid">
            <div class="store-utility-card">
                <h2 class="body-strong">Formação</h2>
                <p class="body">Técnico em Informática — Instituto Federal</p>
            </div>

            <div class="store-utility-card">
                <h2 class="body-strong">Tecnologias</h2>
                <div class="tags">
                    <span class="configurator-option-chip">C#</span>
                    <span class="configurator-option-chip">NestJS</span>
                    <span class="configurator-option-chip">TypeScript</span>
                    <span class="configurator-option-chip">PostgreSQL</span>
                    <span class="configurator-option-chip">Linux</span>
                    <span class="configurator-option-chip">Docker</span>
                    <span class="configurator-option-chip">Git</span>
                </div>
            </div>

            <div class="store-utility-card">
                <h2 class="body-strong">Objetivo</h2>
                <p class="body">Evoluir como desenvolvedor backend, aprofundando conhecimentos em arquitetura, infraestrutura e tecnologias de alta performance.</p>
            </div>
        </div>
    </div>
</section>