@page "/minha-historia"

<PageTitle>Minha História — Uriel</PageTitle>

<section class="historia">
    <div class="hero-section product-tile-parchment">
        <div class="hero-content">
            <h2 class="tagline">Sobre mim</h2>
            <h1 class="display-lg">Minha História</h1>
            <p class="lead">Conheça um pouco sobre minha trajetória na tecnologia.</p>
        </div>
    </div>

    <div class="timeline product-tile-light">
        <div class="timeline-grid">
            <div class="store-utility-card">
                <h2 class="body-strong">Onde tudo começou</h2>
                <p class="body">Comecei na área de tecnologia estudando desenvolvimento, redes e programação no Instituto Federal.</p>
                <div class="tags">
                    <span class="configurator-option-chip">Linux</span>
                    <span class="configurator-option-chip">Redes</span>
                    <span class="configurator-option-chip">Dev Web</span>
                </div>
            </div>

            <div class="store-utility-card">
                <h2 class="body-strong">Onde estou agora</h2>
                <p class="body">Hoje meu foco está em backend, APIs REST, C#, NestJS e desenvolvimento de sistemas.</p>
                <div class="tags">
                    <span class="configurator-option-chip">C#</span>
                    <span class="configurator-option-chip">NestJS</span>
                    <span class="configurator-option-chip">PostgreSQL</span>
                </div>
            </div>

            <div class="store-utility-card">
                <h2 class="body-strong">Para onde vou</h2>
                <p class="body">Venho aprofundando estudos em infraestrutura, arquiteturas backend e tecnologias como Go, Docker e Kubernetes.</p>
                <div class="tags">
                    <span class="configurator-option-chip">Go</span>
                    <span class="configurator-option-chip">Docker</span>
                    <span class="configurator-option-chip">Kubernetes</span>
                </div>
            </div>
        </div>
    </div>
</section>