@page "/contato"

<PageTitle>Contato — Uriel</PageTitle>

<section class="contato">
    <div class="hero-section product-tile-light">
        <div class="hero-content">
            <h2 class="tagline">Contato</h2>
            <h1 class="display-lg">Vamos conversar</h1>
            <p class="lead">Aberto para oportunidades, projetos e conexões na área de tecnologia.</p>
        </div>
    </div>

    <div class="contact-content product-tile-parchment">
        <div class="contact-layout">
            
            <div class="contact-grid">
                <div class="store-utility-card">
                    <h2 class="body-strong">Email</h2>
                    <a href="mailto:andradeleiru@gmail.com" class="text-link">📧 andradeleiru@gmail.com</a>
                </div>

                <div class="store-utility-card">
                    <h2 class="body-strong">GitHub</h2>
                    <a href="https://github.com/UrielAndrade" target="_blank" class="text-link">🐙 Git - Uriel</a>
                </div>

                <div class="store-utility-card">
                    <h2 class="body-strong">LinkedIn</h2>
                    <a href="https://www.linkedin.com/in/uriel-luiz-a019b2353/" target="_blank" class="text-link">💼 in/uriel-luiz</a>
                </div>
            </div>

            <div class="contact-form-card store-utility-card">
                <h2 class="display-lg form-title">/tell Uriel</h2>
                <p class="body" style="margin-bottom: 24px; text-align: center; color: #555;">Envie uma mensagem direta para mim no servidor.</p>
                
                <form class="mc-form">
                    <div class="form-group">
                        <label class="body-strong">Seu Nickname (Nome):</label>
                        <input type="text" class="mc-input" placeholder="Steve..." />
                    </div>

                    <div class="form-group">
                        <label class="body-strong">Seu Correio (Email):</label>
                        <input type="email" class="mc-input" placeholder="steve@craft.com" />
                    </div>

                    <div class="form-group">
                        <label class="body-strong">Mensagem:</label>
                        <textarea class="mc-input mc-textarea" placeholder="Olá, gostaria de falar sobre..."></textarea>
                    </div>

                    <button type="button" class="text-link form-submit">✉️ Enviar Mensagem</button>
                </form>
            </div>

        </div>
    </div>
</section>
