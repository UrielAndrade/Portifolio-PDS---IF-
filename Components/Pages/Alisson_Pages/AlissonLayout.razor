@inherits LayoutComponentBase

<div class="layout-root alisson-theme">
    <!-- Particle Background -->
    <AlissonParticlesBackground />

    <!-- Navigation -->
    <AlissonNavMenu />

    <!-- Page Content -->
    <main class="main-content">
        <article class="page-transition">
            @Body
        </article>
    </main>

    <!-- Footer -->
    <footer class="hk-footer">
        <div class="footer-inner">
            <div class="footer-logo">
                <span class="text-soul glow-soul">✦</span>
                <span class="text-pale">Alisson Caio</span>
                <span class="text-soul glow-soul">✦</span>
            </div>
            <p class="footer-quote text-silver">
                <em>"Not dead, not alive. Sealed away, with nothing but silence and cold."</em>
            </p>
            <div class="footer-links">
                <a href="https://github.com/Bilissom" target="_blank" class="footer-link" id="footer-github">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                    GitHub
                </a>
                <span class="text-stone">·</span>
                <a href="mailto:alissoncaiosilvasilveira70@gmail.com" class="footer-link" id="footer-email">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:4px">
                        <rect x="2" y="4" width="20" height="16" rx="2"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                    Email
                </a>
            </div>
            <p class="footer-copy text-silver">
                © @DateTime.Now.Year Alisson Caio · Forjado nas profundezas de Hallownest
            </p>
        </div>
    </footer>
</div>

<style>
    .layout-root {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .main-content {
        flex: 1;
        position: relative;
        z-index: 1;
        padding-top: 70px; /* nav height */
    }

    .hk-footer {
        background: linear-gradient(to top, var(--void-black), var(--deep-cave));
        border-top: 1px solid var(--stone-dark);
        padding: var(--space-xl) var(--space-lg);
        position: relative;
        z-index: 1;
    }

    .footer-inner {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .footer-logo {
        font-family: var(--font-title);
        font-size: 1.3rem;
        letter-spacing: 0.2em;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-md);
    }

    .footer-quote {
        font-style: italic;
        font-size: 0.9rem;
        opacity: 0.7;
    }

    .footer-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-md);
        font-family: var(--font-title);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .footer-link {
        color: var(--silk-silver);
        transition: color var(--transition-base);
    }
    .footer-link:hover { color: var(--soul-blue); }

    .text-stone { color: var(--stone-mid); }

    .footer-copy {
        font-size: 0.75rem;
        opacity: 0.5;
    }
</style>
